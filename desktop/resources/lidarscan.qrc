<!--
  lidarscan.qrc — the redesign's bundled typefaces.

  All three families are SIL Open Font License 1.1. The licence texts ship
  INSIDE the binary alongside the fonts (":/licenses/*") rather than only next
  to the source, because OFL §2 requires the notice to travel with the font,
  and a .app bundle / .exe that embeds the .ttf but leaves the licence in the
  repo does not satisfy that. Theme.cpp's licenceText() reads them back out so
  Help -> About can show them.

  Static instances, not the variable ("[wght].ttf") builds Google Fonts now
  publishes: QFontDatabase::addApplicationFont registers a variable font's
  DEFAULT instance only, so a QSS `font-weight: 600` against one silently
  renders Regular. Four Inter weights / three Space Grotesk / three JetBrains
  Mono is the smallest set that covers every weight the stylesheet asks for.
-->
<RCC>
  <qresource prefix="/fonts">
    <file alias="Inter-Regular.ttf">fonts/Inter-Regular.ttf</file>
    <file alias="Inter-Medium.ttf">fonts/Inter-Medium.ttf</file>
    <file alias="Inter-SemiBold.ttf">fonts/Inter-SemiBold.ttf</file>
    <file alias="Inter-Bold.ttf">fonts/Inter-Bold.ttf</file>
    <file alias="SpaceGrotesk-Regular.ttf">fonts/SpaceGrotesk-Regular.ttf</file>
    <file alias="SpaceGrotesk-Medium.ttf">fonts/SpaceGrotesk-Medium.ttf</file>
    <file alias="SpaceGrotesk-Bold.ttf">fonts/SpaceGrotesk-Bold.ttf</file>
    <file alias="JetBrainsMono-Regular.ttf">fonts/JetBrainsMono-Regular.ttf</file>
    <file alias="JetBrainsMono-Medium.ttf">fonts/JetBrainsMono-Medium.ttf</file>
    <file alias="JetBrainsMono-Bold.ttf">fonts/JetBrainsMono-Bold.ttf</file>
  </qresource>
  <qresource prefix="/licenses">
    <file alias="Inter-OFL.txt">fonts/licenses/Inter-OFL.txt</file>
    <file alias="SpaceGrotesk-OFL.txt">fonts/licenses/SpaceGrotesk-OFL.txt</file>
    <file alias="JetBrainsMono-OFL.txt">fonts/licenses/JetBrainsMono-OFL.txt</file>
  </qresource>
</RCC>
