<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- B2: D6 connect flow (Tech Spec §3.1 Android row — USB-C OTG serial). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- B3 (Tech Spec §3.1 Android row — Mid-360 over USB-C Ethernet).

         INTERNET is NOT about the internet here, and it is not optional: on
         Android the socket(2) syscall itself is gated on the app being in the
         `inet` supplementary group, which is granted by holding this
         permission. Without it, every UDP socket — the ones this app creates
         for the pre-bound path AND the ones the Livox SDK creates inside
         native code — fails at creation with EACCES, which reads like a
         firewall problem and is not.

         ACCESS_NETWORK_STATE is what ConnectivityManager's
         registerNetworkCallback/getLinkProperties need.

         CHANGE_NETWORK_STATE is declared because requestNetwork() asks for
         it — but its protection level is signature|preinstalled|appop|pre23,
         so a normal build will NOT be granted it and requestNetwork() throws
         SecurityException. EthernetMonitor catches that and falls back to
         registerNetworkCallback, which needs only ACCESS_NETWORK_STATE and
         delivers the same callbacks. Declaring it costs nothing and lets a
         privileged/OEM build take the stronger path. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Ethernet is a real hardware requirement for the Mid-360 path, but
         "required" would hide the app from every phone that can still do D6,
         replay and review. Same trade as the ARCore feature below. -->
    <uses-feature android:name="android.hardware.ethernet" android:required="false" />

    <!-- B4: Filament's OpenGL backend needs ES 3.0+ (the min it links against);
         declared so a store listing / device-compatibility check can filter
         correctly rather than only finding out at Engine.create() time. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- B7/B8 (Tech Spec §3.3, §3.5, §3.7): ARCore supplies the D6's
         trajectory, the AR overlay's camera background, and the camera
         keyframes colorization needs. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- "optional", not "required": the app is still fully usable on a
         non-ARCore device for Mid-360 live SLAM, replay and review — only the
         AR overlay, the mount wizard and the D6's pushbroom trajectory need
         it. Marking it required would hide the app from those devices in the
         Play Store for no reason. The in-app copy says which features are
         unavailable (see ArAvailability.message()). -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <!-- ROUND 9 (owner item 35): the phone's own gyro + accelerometer, pushed
         into the engine's IMU-densified pose interpolator.

         ARCore poses arrive at ~30 Hz while the COIN-D6 samples at 4000 Hz, so
         every return is interpolated; integrating the phone's gyro across each
         33 ms ARCore interval is what makes that interpolation follow a walking
         human instead of a dolly (engine-side: wall plane-fit RMS 0.739 cm ->
         0.021 cm). The benefit scales with how much of that interval the IMU
         actually samples.

         Android caps sensor delivery at 200 Hz for apps that do not hold
         HIGH_SAMPLING_RATE_SENSORS, whatever the sensor's own minDelay says and
         whatever SENSOR_DELAY_FASTEST asks for. This permission lifts that cap
         to the hardware's real rate (400+ Hz on modern phones). It is
         INSTALL-TIME (protection level "normal"), so there is no runtime prompt
         and nothing to ask the operator — declaring it is the whole of it.
         PhoneImuRecorder measures the rate it actually gets and reports it, so
         a device that grants less says so rather than being assumed. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- B9 (Tech Spec §2.3, §3.1's "RTK rover: Bluetooth SPP (Android)").

         API 31+ replaced the old install-time BLUETOOTH/BLUETOOTH_ADMIN pair
         with runtime permissions. This app connects to an ALREADY-PAIRED rover
         and never scans, so it needs BLUETOOTH_CONNECT and NOT BLUETOOTH_SCAN
         — which is worth having, because BLUETOOTH_SCAN (and, before 31, any
         discovery at all) drags in a location permission, and a survey app
         asking for the phone's location while an RTK receiver is attached is
         both confusing and unnecessary. Pairing happens once in the system
         Bluetooth settings, which already handle the PIN dialog properly.

         The two legacy permissions are capped at maxSdkVersion 30 so they are
         not requested on newer releases where they no longer exist. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- ROUND 5.2 — phone-location georeferencing fallback.
         When no RTK rover is connected, a capture georeferences itself from the
         phone's own location at the accuracy Android reports (see
         com.lidarscan.app.gnss.PhoneLocationSource and
         com.lidarscan.core.gnss.GeorefSourcePolicy). FINE, not COARSE: a
         network-derived fix is hundreds of metres and would be worse than no
         georeference at all, and COARSE would silently give us exactly that.

         The permission is requested at the moment a capture STARTS and only when
         no rover fix is present — never on app launch and never on opening the
         Capture tab. Denial is not fatal: the scan records in its own local frame
         and says so once. This is also why the comment above about "a survey app
         asking for the phone's location" no longer applies unchanged — with a
         rover attached, nothing here ever asks.

         Not FOREGROUND_SERVICE_LOCATION / background location: capture is a
         foreground, screen-on activity, and the fallback stops with it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".LidarScanApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LidarScan">

        <!-- "optional" matches the uses-feature above: Google Play will not
             refuse to install on a device without ARCore, and ArCoreApk's
             availability check + install flow handle it at runtime
             (com.lidarscan.app.ar.ArInstaller). "required" would make the
             Play Store install ARCore automatically but also exclude every
             non-AR device, which is the wrong trade for a capture app whose
             Mid-360 path needs no AR at all. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <!-- B6/B11: §3.8's "Extract for transfer" (share the .lscan.zip) and
             the DXF/PDF plan exports both hand a file to another app through
             the share sheet. A FileProvider is the only supported way to do
             that since API 24 — a bare file:// Uri throws FileUriExposedException
             — and it grants read access to exactly the one Uri, for the life of
             the receiving activity, rather than exporting a directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LidarScan"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- B2: launch straight into the app when a D6/CH340 adapter is
                 plugged in via USB-C OTG (Tech Spec §3.1's "permission/attach
                 flow"). The already-running case (app in foreground) is
                 handled by MainActivity's dynamically-registered receiver,
                 not this filter — this one only fires a cold/background launch. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>

</manifest>
