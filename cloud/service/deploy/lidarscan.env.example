# EnvironmentFile for lidarscan-service.service. chmod 600 — it holds the token.
#
# Generate the token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LIDARSCAN_TOKEN=replace-me-with-32-bytes-of-randomness

LIDARSCAN_DATA_DIR=/var/lib/lidarscan

# Tech Spec §3.8's hard cap. 2 GiB.
LIDARSCAN_MAX_UPLOAD_BYTES=2147483648

# The worker. {input} is the extracted .lscan directory, {output} is the
# directory whose contents become the downloadable result bundle.
LIDARSCAN_WORKER_CMD=/opt/lidarscan/bin/engine_cli --post {input} --out {output}

# Kill a job that outlives this (seconds).
LIDARSCAN_JOB_TIMEOUT_S=3600

LIDARSCAN_HOST=127.0.0.1
LIDARSCAN_PORT=8080

# Set to 1 to keep extracted inputs after a SUCCESSFUL job (failures always
# keep theirs). Costs disk; useful while tuning the pipeline.
LIDARSCAN_KEEP_INPUTS=0

# Only when the service is mounted on a subpath by the reverse proxy, e.g.
# https://cloud.example.com/lidarscan/jobs.
#LIDARSCAN_URL_PREFIX=/lidarscan
